# Backend Production Dockerfile
# Multi-stage build: build toolchain only in builder, lean runtime image

# Stage 1: Install dependencies (native modules may need build tools)
FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./

# Native deps (bcrypt) need build tools; use npm ci for reproducible install
RUN apk add --no-cache python3 make g++ && npm ci

# Stage 2: Runtime
FROM node:20-alpine

WORKDIR /app

ENV NODE_ENV=production

# Copy only production dependencies and app code
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY . .

# Create non-root user
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN mkdir -p /app/keys && chown -R appuser:appgroup /app

USER appuser

# Expose port
ARG PORT=3000
EXPOSE $PORT

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:$PORT/health || exit 1

# Start application
CMD ["npm", "start"]
