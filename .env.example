# Docker Environment Configuration
# Copy this file to .env and update with your values

# Node Environment
NODE_ENV=development

# Backend (port 3000)
PORT=3000
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
FRONTEND_URL=http://localhost:5173
INSTITUTION_API_URL=http://institution-api:4000

# MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=voting_user
DB_PASSWORD=voting_pass
DB_NAME=voting_db
DB_ROOT_PASSWORD=voting_root_pass

# MySQL Docker defaults
MYSQL_ROOT_PASSWORD=voting_root_pass
MYSQL_DATABASE=voting_db
MYSQL_USER=voting_user
MYSQL_PASSWORD=voting_pass

# Frontend Configuration (port 5173)
VITE_API_BASE_URL=http://localhost:3000
VITE_BLOCKCHAIN_URL=http://localhost:3001
VITE_DEVTOOLS=false

# Blockchain Node (port 3001)
BLOCKCHAIN_NODE_URL=http://blockchain-node:3001
NODE_ID=node1
NODE_TYPE=validator
PEERS=

# SMTP / Email (optional, backend)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=University Voting System
SMTP_FROM_EMAIL=noreply@university.edu

