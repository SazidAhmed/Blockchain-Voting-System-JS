# Docker Environment Configuration

# ─── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
DEV_OTP_DEBUG=false

# ─── Service Ports ─────────────────────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=5173
ADMIN_PANEL_PORT=5174
INSTITUTION_PORT=4000
BLOCKCHAIN_NODE1_PORT=3001
BLOCKCHAIN_NODE2_PORT=3002
BLOCKCHAIN_NODE3_PORT=3003
BLOCKCHAIN_NODE4_PORT=3004
BLOCKCHAIN_NODE5_PORT=3005

# ─── Host Access Ports (external-facing services) ──────────────────────────────
PMA_HOST_PORT=8080

# ─── Monitoring Host Ports ─────────────────────────────────────────────────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3030
GRAFANA_ROOT_URL=http://localhost:3030
GRAFANA_ADMIN_PASSWORD=change-me # REQUIRED: In production (min 12 chars)
CADVISOR_PORT=8081
NODE_EXPORTER_PORT=9100
LOKI_PORT=3100

# ─── MySQL ─────────────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=voting_user
DB_PASSWORD=change-me
DB_NAME=voting_db
DB_ROOT_PASSWORD=change-me

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=voting_db
MYSQL_USER=voting_user
MYSQL_PASSWORD=change-me

# ─── Institution API Database ──────────────────────────────────────────────────
INSTITUTION_DB_NAME=institution_db

# ─── Backend ───────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
NULLIFIER_SECRET=change-me-to-another-random-secret-at-least-32-chars
FRONTEND_URL=http://localhost:5173
ADMIN_PANEL_URL=http://localhost:5174
BACKEND_URL=http://backend:3000
INSTITUTION_API_URL=http://institution-api:4000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ─── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:3000
VITE_BLOCKCHAIN_URL=http://localhost:3001
VITE_INSTITUTION_API_URL=http://localhost:4000
VITE_DEVTOOLS=false

# Frontend sends this to the blockchain node when browsing chain/status data
VITE_BLOCKCHAIN_API_KEY=change-me

# Admin panel sends this to the institution API for directory lookups (C-09)
VITE_INSTITUTION_API_KEY=change-me

# ─── Blockchain Node ───────────────────────────────────────────────────────────
BLOCKCHAIN_NODE_URL=http://blockchain-node:3001
NODE_ID=node1
NODE_TYPE=validator
PEERS=

# ─── API Key ───────────────────────────────────────────────────────────────────
BLOCKCHAIN_API_KEY=change-me
INSTITUTION_API_KEY=change-me

# ─── SMTP / Email (optional) ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=University Voting System
SMTP_FROM_EMAIL=noreply@university.edu
