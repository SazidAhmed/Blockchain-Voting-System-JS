#!/usr/bin/env bash
# .githooks/pre-push
# Runs automatically before every push.
# Runs the full check suite to catch anything pre-commit missed.
set -euo pipefail

RED='\033[0;31m'
GREEN='\033[0;32m'
NC='\033[0m'

SCRIPT_DIR="$(git rev-parse --show-toplevel)/scripts"

echo "Running pre-push checks..."
echo ""

if ! bash "$SCRIPT_DIR/run-all-checks.sh"; then
  echo ""
  echo -e "${RED}Push blocked. Fix the issues above and try again.${NC}"
  exit 1
fi

echo ""
echo -e "${GREEN}✓ All pre-push checks passed${NC}"
